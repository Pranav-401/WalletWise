@model List<WalletWise.Models.Expense>

@{
    ViewData["Title"] = "My Expenses";
}

<link rel="stylesheet"
      href="~/css/ExpensesIndex.css"
      asp-append-version="true" />

<div class="expenses-page">

    <!-- Page Header -->
    <div class="expenses-page-header">

        <div class="expenses-heading">
            <h1 class="expenses-page-title">My Expenses</h1>
            <p class="expenses-page-subtitle">
                Manage and track your daily spending.
            </p>
        </div>

        <div class="expenses-header-actions">

            <a asp-controller="Analysis"
               asp-action="Index"
               class="expenses-btn expenses-btn-secondary">
                <i class="bi bi-graph-up"></i>
                Analysis
            </a>

            <a asp-controller="Expenses"
               asp-action="Create"
               class="expenses-btn expenses-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Expense
            </a>

        </div>
    </div>


    <!-- Expense History -->
    <section class="expenses-card">

        <div class="expenses-card-header">

            <div>
                <h2 class="expenses-card-title">Expense History</h2>
                <p class="expenses-card-subtitle">
                    View and manage your recorded expenses.
                </p>
            </div>

            <span class="expenses-count">
                @Model.Count Records
            </span>

        </div>


        @if (Model.Count == 0)
        {
            <!-- Empty State -->
            <div class="expenses-empty-state">

                <div class="expenses-empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3>No expenses yet</h3>

                <p>
                    Start tracking your spending by adding your first expense.
                </p>

                <a asp-action="Create"
                   class="expenses-btn expenses-btn-primary">
                    <i class="bi bi-plus-lg"></i>
                    Add Your First Expense
                </a>

            </div>
        }
        else
        {
            <!-- Desktop and Tablet Table -->
            <div class="table-responsive d-none d-md-block">

                <table class="table expenses-table">

                    <thead>
                        <tr>
                            <th class="expense-number-column">#</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var expense = Model[i];

                            <tr>
                                <td class="expense-row-number">
                                    @(i + 1)
                                </td>

                                <td>
                                    <span class="expense-description">
                                        @expense.Description
                                    </span>
                                </td>

                                <td>
                                    <span class="expense-amount">
                                        ₹@expense.Amount.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    <span class="expense-category">
                                        @expense.Category
                                    </span>
                                </td>

                                <td>
                                    <span class="expense-date">
                                        @expense.Date.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <div class="expense-desktop-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@expense.Id"
                                           class="expenses-btn expenses-btn-edit">
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@expense.Id"
                                           class="expenses-btn expenses-btn-delete">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>


            <!-- Mobile Expense Cards -->
            <div class="expenses-mobile-list d-md-none">

                @foreach (var expense in Model)
                {
                    <article class="mobile-expense-card">

                        <div class="mobile-expense-top">

                            <div class="mobile-expense-info">

                                <h3 class="mobile-expense-description">
                                    @expense.Description
                                </h3>

                                <span class="expense-category">
                                    @expense.Category
                                </span>

                            </div>

                            <span class="mobile-expense-amount">
                                ₹@expense.Amount.ToString("N2")
                            </span>

                        </div>


                        <div class="mobile-expense-footer">

                            <span class="expense-date">
                                <i class="bi bi-calendar3"></i>
                                @expense.Date.ToString("dd MMM yyyy")
                            </span>

                            <div class="expense-mobile-actions">

                                <a asp-action="Edit"
                                   asp-route-id="@expense.Id"
                                   class="expenses-btn expenses-btn-edit">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@expense.Id"
                                   class="expenses-btn expenses-btn-delete">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </section>

</div>
