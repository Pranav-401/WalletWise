@model WalletWise.Models.Expense

@{
    ViewData["Title"] = "Financial Reports";
}

<link rel="stylesheet"
      href="~/css/ExpensesIndex.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/AnalysisIndex.css"
      asp-append-version="true" />

<div class="expenses-page analysis-page">

    <!-- Page Header -->
    <div class="expenses-page-header">
        <div class="expenses-heading">
            <h1 class="expenses-page-title">Financial Reports</h1>
            <p class="expenses-page-subtitle">
                Understand where your money goes and track your spending.
            </p>
        </div>

        <a asp-action="Index"
           asp-controller="Expenses"
           class="expenses-btn expenses-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Expenses
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="analysis-summary-grid">

        <div class="expenses-card analysis-summary-card">

            <div>
                <p class="analysis-summary-label">Total Expenses</p>
                <h2 class="analysis-summary-value">
                    ₹<span id="totalExpenses">0.00</span>
                </h2>
            </div>
        </div>

        <div class="expenses-card analysis-summary-card">

            <div>
                <p class="analysis-summary-label">Categories</p>
                <h2 class="analysis-summary-value" id="totalCategories">
                    0
                </h2>
            </div>
        </div>

    </div>

    <!-- Spending Chart -->
    <section class="expenses-card analysis-section-card">

        <div class="analysis-section-heading">
            <div>
                <h2 class="expenses-card-title">Spending by Category</h2>
                <p class="expenses-card-subtitle">
                    Breakdown of your expenses across different categories.
                </p>
            </div>
        </div>

        <div class="analysis-divider"></div>

        <div class="analysis-chart-container" id="chartContainer">
            <canvas id="myChart"></canvas>
        </div>

        <div id="chartError" class="analysis-message analysis-error"
             style="display:none;">
            <i class="bi bi-exclamation-circle"></i>
            <span>Unable to load expense data. Please try again later.</span>
        </div>

        <div id="chartEmpty" class="analysis-message"
             style="display:none;">
            <i class="bi bi-pie-chart"></i>
            <p>No expenses recorded yet.</p>
            <a asp-controller="Expenses"
               asp-action="Create"
               class="expenses-btn expenses-btn-primary">
                <i class="bi bi-plus-lg"></i>
                Add Your First Expense
            </a>
        </div>

    </section>

    <!-- Category Breakdown -->
    <section class="expenses-card analysis-section-card">

        <div class="analysis-section-heading">
            <div>
                <h2 class="expenses-card-title">Category Breakdown</h2>
                <p class="expenses-card-subtitle">
                    See how much you have spent in each category.
                </p>
            </div>
        </div>

        <div class="analysis-divider"></div>

        <div id="categoryBreakdown" class="analysis-category-list">
            <p class="analysis-loading">
                Loading category data...
            </p>
        </div>

    </section>

    <section class="expenses-card analysis-section-card ai-insights-section">

        <!-- Section Header -->
        <div class="analysis-section-heading">
            <div>
                <h2 class="expenses-card-title">
                    <i class="bi bi-stars"></i>
                    AI Financial Insights
                </h2>

                <p class="expenses-card-subtitle">
                    Understand your spending habits and discover ways to improve your finances.
                </p>
            </div>

            <button type="button"
                    id="generateInsightsBtn"
                    class="expenses-btn expenses-btn-primary">
                <i class="bi bi-stars"></i>
                Generate Insights
            </button>
        </div>

        <div class="analysis-divider"></div>

        <!-- Loading State -->
        <div id="insightsLoading"
             class="analysis-message"
             style="display: none;">

            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <p>Analyzing your spending patterns...</p>
        </div>

        <!-- Error State -->
        <div id="insightsError"
             class="analysis-message analysis-error"
             style="display: none;">

            <i class="bi bi-exclamation-circle"></i>
            <span id="insightsErrorText"></span>
        </div>

        <!-- AI Results -->
        <div id="insightsContent" style="display: none;">

            <!-- Summary -->
            <div class="ai-insight-block">
                <h3 class="ai-insight-heading">
                    <i class="bi bi-clipboard-data"></i>
                    Financial Summary
                </h3>

                <p id="insightsSummary" class="ai-insight-text"></p>
            </div>

            <div class="analysis-divider"></div>

            <!-- Observations -->
            <div class="ai-insight-block">
                <h3 class="ai-insight-heading">
                    <i class="bi bi-search"></i>
                    Spending Observations
                </h3>

                <ul id="insightsObservations" class="ai-insight-list"></ul>
            </div>

            <div class="analysis-divider"></div>

            <!-- Improvements -->
            <div class="ai-insight-block">
                <h3 class="ai-insight-heading">
                    <i class="bi bi-lightbulb"></i>
                    Improvement Suggestions
                </h3>

                <div id="insightsImprovements"></div>
            </div>

            <div class="analysis-divider"></div>

            <!-- Positive Habits -->
            <div class="ai-insight-block">
                <h3 class="ai-insight-heading">
                    <i class="bi bi-check-circle"></i>
                    Positive Financial Habits
                </h3>

                <ul id="insightsPositiveHabits" class="ai-insight-list"></ul>
            </div>

        </div>

    </section>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/analysis.js" asp-append-version="true"></script>
<script src="~/js/insight.js" asp-append-version="true"></script>